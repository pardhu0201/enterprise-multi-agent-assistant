# ---------------------------------------------------------------------------
# Enterprise Multi-Agent AI Assistant - environment template
# Copy to `.env` (repo root) and fill in. Every value below has a working
# default, so the app boots with an EMPTY .env in fully-free "demo" mode.
# ---------------------------------------------------------------------------

# --- LLM -------------------------------------------------------------------
# Leave ANTHROPIC_API_KEY blank to run in deterministic demo mode (no cost).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max
LLM_EFFORT=medium
LLM_MAX_TOKENS=8000

# --- Database --------------------------------------------------------------
# Blank -> local SQLite at backend/data/runtime/app.db
# Neon example: postgresql+psycopg://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Retrieval -------------------------------------------------------------
# hashing (no deps, free) | sentence-transformers (better, needs extra install)
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIM=384
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATES=24

# --- Policy / governance ---------------------------------------------------
# Confidence below this forces a human review even for read-only answers.
CONFIDENCE_THRESHOLD=0.55
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- App -------------------------------------------------------------------
APP_ENV=local
SEED_ON_STARTUP=true
LOG_LEVEL=INFO
